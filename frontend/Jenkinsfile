// frontend/Jenkinsfile
pipeline {
  agent any

  environment {
    APP_BRANCH           = 'staging'
    DOCKER_IMAGE         = 'tanpiyangkoon/it-request-frontend'
    DOCKER_CREDENTIALS   = 'dockerhub-credentials'
    GIT_CONFIG_REPO      = 'git@github.com:tanPiyangkoon/it-request-frontend-kustomize.git'
    GIT_CONFIG_BRANCH    = 'main'
    GIT_CREDENTIALS      = 'github-ssh'
    NODE_IMAGE           = 'node:20-alpine'
  }

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  stages {
    stage('Checkout Code') {
      steps {
        checkout scm
        script {
          def shortSha = sh(script: "git rev-parse --short=11 HEAD", returnStdout: true).trim()
          env.IMG_TAG = "${APP_BRANCH}-${shortSha}-${BUILD_NUMBER}"
          env.HOST_UID = sh(script: 'id -u', returnStdout: true).trim()
          env.HOST_GID = sh(script: 'id -g', returnStdout: true).trim()
          echo "Building: ${DOCKER_IMAGE}:${env.IMG_TAG}"
        }
      }
    }

    stage('Build Frontend') {
      steps {
        dir('frontend') {
          script {
            docker.image(NODE_IMAGE).inside("--user 0:0 -e HOST_UID=${env.HOST_UID} -e HOST_GID=${env.HOST_GID}") {
              sh '''
                set -e
                apk add --no-cache git
                npm ci
                npm run build
                chown -R "$HOST_UID:$HOST_GID" .
              '''
            }
          }
        }
      }
    }

    stage('Build & Tag Docker Image') {
      steps {
        dir('frontend') {
          sh """
            set -e
            docker build -f Dockerfile -t ${DOCKER_IMAGE}:${env.IMG_TAG} -t ${DOCKER_IMAGE}:latest .
          """
        }
      }
    }

    stage('Push to Docker Hub') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: DOCKER_CREDENTIALS,
          usernameVariable: 'DH_USER',
          passwordVariable: 'DH_TOKEN'
        )]) {
          sh """
            set -e
            echo "$DH_TOKEN" | docker login --username "$DH_USER" --password-stdin
            docker push ${DOCKER_IMAGE}:${env.IMG_TAG}
            docker push ${DOCKER_IMAGE}:latest
            docker logout || true
          """
        }
      }
    }

    stage('Update GitOps') {
      steps {
        withCredentials([sshUserPrivateKey(
          credentialsId: GIT_CREDENTIALS,
          keyFileVariable: 'SSH_KEY',
          usernameVariable: 'GIT_USER'
        )]) {
          sh '''
            set -e
            rm -rf k8s-config
            mkdir -p ~/.ssh
            cp "$SSH_KEY" ~/.ssh/id_ed25519
            chmod 600 ~/.ssh/id_ed25519
            ssh-keyscan github.com >> ~/.ssh/known_hosts 2>/dev/null

            git clone -b "${GIT_CONFIG_BRANCH}" "${GIT_CONFIG_REPO}" k8s-config
            cd k8s-config/overlays/${APP_BRANCH}

            if command -v yq >/dev/null 2>&1; then
              yq -i "(.images[] | select(.name == \"${DOCKER_IMAGE}\").newTag) = \"${env.IMG_TAG}\"" kustomization.yaml
            else
              sed -i "s|newTag: .*|newTag: ${env.IMG_TAG}|" kustomization.yaml
            fi

            git config user.email "jenkins@local"
            git config user.name "Jenkins CI"
            git add kustomization.yaml

            if ! git diff --staged --quiet; then
              git commit -m "CI: bump ${DOCKER_IMAGE} to ${env.IMG_TAG}"
              git push origin ${GIT_CONFIG_BRANCH}
              echo "GitOps updated!"
            else
              echo "No changes"
            fi
          '''
        }
      }
    }
  }

  post {
    success { echo "SUCCESS: ${DOCKER_IMAGE}:${env.IMG_TAG}" }
    failure { echo 'FAILED' }
    always  { cleanWs() }
  }
}